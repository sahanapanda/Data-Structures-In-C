#include <stdio.h>
#include <stdlib.h>
struct node{
    int data;
    struct node *next;
} *temp, *head = NULL, *new_node;

void create(){
    new_node = (struct node*)malloc(sizeof(struct node));
    printf("Enter Element : ");
    scanf("%d", &new_node->data);
    new_node -> next = new_node;

    if(head == NULL){
        head = new_node;
        temp = new_node;
    }
    else{
        temp -> next = new_node;
        new_node -> next = head;
        temp = new_node;
    }
}
void display(){
    temp = head;
    if(temp == NULL){
        printf("List is empty");
    }
    else{
        do{
            printf("%d->", temp -> data);
            temp = temp -> next;
        }while(temp!=head);
    printf("Back to head");
    }
}
int main(){
    int n;
    printf("Enter number of elements you want to create : ");
    scanf("%d", &n);
    for(int i=0; i<n; i++){
        create();
    }
    printf("Linked List: ");
    display();
    
    return 0;
