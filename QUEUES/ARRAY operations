#include <stdio.h>
#define size 10
int queue[size];
int front = -1; 
int rear = -1;

void enqueue(){
    if(rear == size-1){
        printf("Queue is Full");
    }
    else{
        rear++;
        printf("Enter element : ");
        scanf("%d", &queue[rear]);
        if (front==-1){
            front++;
        }
    }
}

void dequeue(){
    if(rear == -1 && front == -1){
        printf("Queue is Empty");
    }
    else if (front == rear){
        front = -1;
        rear = -1;
    }
    else{
        printf("\nElement to be deleted : %d", queue[front]);
        front++;
    }
}

void display(){
    if(rear == -1 && front == -1){
        printf("Queue is Empty");
    }
    else{
        for(int i=front; i<=rear; i++){
            printf("%d ", queue[i]);
        }
    }
}

int main(){
    int n;
    printf("Enter number of elements for the queue: ");
    scanf("%d", &n);
    for(int i=0; i<n; i++){
        enqueue();
    }
    printf("\nQUEUE : ");
    display();

    dequeue();
    printf("\nModified Queue: ");
    display();

    return 0;
}
