#include <stdio.h>
#define size 10
int stack[size];
int top = -1;

void push(){
    if (top==size-1){
        printf("Stack is full");
    }
    else{
        top++;
        printf("Enter element : ");
        scanf("%d", &stack[top]);
    }
}

void pop(){
    if(top==-1){
        printf("Stack is empty");
    }
    else{
        printf("\nElement deleted is %d", stack[top]);
        top--;
    }
}

void peek(){
    if(top==-1){
        printf("Stack is empty");
    }
    else{
        printf("\nTop element is %d", stack[top]);
    }
}
 void display(){
    if(top==-1){
        printf("Stack is empty");
    }
    else{
        for(int i=top; i>=0; i--){
            printf("%d ", stack[i]);
        }
    }
 }

int main(){
    int n;
    printf("Enter number of elements in the stack you want to push : ");
    scanf("%d", &n);
    for(int i=0; i<n; i++){
        push();
    }
    printf("Stack : ");
    display();

    pop();
    printf("\nModified Stack after pop operation : ");
    display();

    peek();

    return 0;
}
