#include <stdio.h>
#include <stdlib.h>
struct node{
    int data;
    struct node *next;
}*top=NULL, *temp, *new_node;

void push(){
    new_node = (struct node*)malloc(sizeof(struct node));
    printf("Enter element : ");
    scanf("%d", &new_node->data);
    new_node->next = NULL;

    if(top==NULL){
        top = new_node;
    }
    else{
        new_node -> next = top;
        top = new_node;
    }
}

void pop(){
    struct node *ele;
    if(top==NULL){
        printf("Stack is empty");
    }
    else{
        ele = top;
        printf("\nElement to be deleted : %d", top->data);
        top = ele->next;
        ele->next = NULL;
        free(ele);
    }
}

void peek(){
    if(top==NULL){
        printf("Stack is empty");
    }
    else{
        printf("\nTop most element is : %d", top->data);
    }
}

void display(){
    temp = top;
    if(top==NULL){
        printf("Stack is empty");
    }
    else{
        while(temp!=NULL){
            printf("%d ", temp-> data);
            temp = temp->next;
        }
    }
    
}

int main(){
    int n;
    printf("Enter number of elements in the stack you want to push : ");
    scanf("%d", &n);
    for(int i=0; i<n; i++){
        push();
    }
    printf("Stack : ");
    display();

    pop();
    printf("\nModified Stack after pop operation : ");
    display();

    peek();

    return 0;
}
